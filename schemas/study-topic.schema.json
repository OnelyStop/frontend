{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://onelystop.local/schemas/study-topic.schema.json",
  "title": "Study topic authoring file",
  "description": "One *.topic.json under content/. The Git-managed source that scripts/study-import.ts projects into Postgres. See docs/study-module-spec.md §6.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subjectSlug",
    "chapterSlug",
    "topicSlug",
    "title",
    "summary",
    "difficulty",
    "estimatedMinutes",
    "examTags",
    "learningObjectives",
    "tags",
    "contentStatus",
    "contentVersion",
    "reviewCadenceDays",
    "sources",
    "blocks",
    "flashcards"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "subjectSlug": { "$ref": "#/$defs/slug" },
    "chapterSlug": { "$ref": "#/$defs/slug" },
    "topicSlug": { "$ref": "#/$defs/slug" },
    "subjectName": { "type": "string", "minLength": 1 },
    "chapterName": { "type": "string", "minLength": 1 },
    "subjectPosition": { "type": "integer", "minimum": 0 },
    "chapterPosition": { "type": "integer", "minimum": 0 },
    "topicPosition": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
    "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 240 },
    "examTags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "prerequisiteTopicSlugs": {
      "type": "array",
      "items": { "$ref": "#/$defs/slug" },
      "default": []
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1 }
    },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "contentStatus": {
      "enum": ["draft", "in_review", "published", "retired"]
    },
    "contentVersion": { "type": "integer", "minimum": 1 },
    "authoredBy": { "type": ["string", "null"] },
    "reviewedBy": { "type": ["string", "null"] },
    "reviewNotes": { "type": ["string", "null"] },
    "lastReviewedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "reviewCadenceDays": { "type": "integer", "minimum": 1 },
    "examCycle": { "type": ["string", "null"] },
    "officialNotificationUrl": { "type": ["string", "null"], "format": "uri" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "blocks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/block" }
    },
    "flashcards": {
      "type": "array",
      "minItems": 6,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/flashcard" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "url",
        "title",
        "publisher",
        "usageMode",
        "retrievedAt"
      ],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "usageMode": {
          "enum": [
            "scope_only",
            "reference_only",
            "open_adaptable",
            "public_domain",
            "policy"
          ]
        },
        "license": { "type": ["string", "null"] },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "sourceUpdatedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "adapted": { "type": "boolean" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "markdown", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "type": {
          "enum": [
            "introduction",
            "objectives",
            "concept",
            "definition",
            "formula",
            "method",
            "worked_example",
            "comparison",
            "shortcut",
            "warning",
            "exam_tip",
            "summary",
            "practice"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "markdown": { "type": "string", "minLength": 1 },
        "sourceIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "searchKeywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "position": { "type": "integer", "minimum": 0 },
        "expectedAnswers": {
          "description": "Optional. For worked_example / practice blocks: declared numeric answers the calculation validator recomputes.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "number" },
              "tolerance": { "type": "number", "minimum": 0 },
              "expression": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "flashcard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "front",
        "back",
        "difficulty",
        "sourceBlockIds",
        "position"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "front": { "type": "string", "minLength": 1, "maxLength": 240 },
        "back": { "type": "string", "minLength": 1, "maxLength": 800 },
        "explanation": { "type": ["string", "null"] },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "sourceBlockIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slug" }
        },
        "status": { "enum": ["draft", "approved", "rejected"] },
        "position": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
