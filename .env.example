# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# ---------------------------------------------------------------------------
# AI. Only OPENROUTER_API_KEY is required; the rest override src/config/env.ts.
# All server-only: never NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Swap any model without a code change or a deploy.
# AI_MODEL_DEFAULT=anthropic/claude-sonnet-4.5
# AI_MODEL_FAST=google/gemini-2.0-flash
# AI_MODEL_FALLBACK=openai/gpt-4o

# LLM_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-user monthly ceiling in micro-dollars. Set a credit limit on the
# OpenRouter key too, as a backstop -- this is the actual control.
# AI_MONTHLY_SPEND_MICROS=2000000
# AI_MAX_TOKENS=2000
# AI_TIMEOUT_MS=60000
# AI_MAX_ATTEMPTS=3
