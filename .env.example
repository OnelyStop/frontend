# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Postgres. Runtime uses the transaction pooler (:6543); drizzle-kit uses DIRECT_URL
# (:5432). For local dev against docker-compose the container listens on
#   host 127.0.0.1, port 5544, database onelystop, user postgres, password postgres
# so DATABASE_URL and DIRECT_URL are both the postgres:// URL built from those.
DATABASE_URL=
# DIRECT_URL=

# Study-module content importer. Defaults to DATABASE_URL when unset; set this to
# aim the importer at a different database than the app runtime.
# STUDY_DATABASE_URL=

# ---------------------------------------------------------------------------
# AI. Only OPENROUTER_API_KEY is required; the rest override src/config/openrouter.ts.
# Server-only: never NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# The model used when a call does not name one.
# AI_MODEL=anthropic/claude-sonnet-4.5
# AI_MODEL_FALLBACK=openai/gpt-4o

# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Defaults for anything a call does not pass. Out-of-range values are ignored.
# AI_TEMPERATURE=0.7          0-2
# AI_MAX_TOKENS=2000          1-32000
# AI_TIMEOUT_MS=60000         per attempt
# AI_TOTAL_TIMEOUT_MS=120000  ceiling across all attempts and models
# AI_MAX_ATTEMPTS=3           1-5
