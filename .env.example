# DIRECT_URL=
# DB_POOL_MAX=3
# DB_IDLE_TIMEOUT_S=20
# DB_STATEMENT_TIMEOUT_MS=15000

# Local sibling checkout of OnelyStop/question-bank, read by import-question-bank.ts.
QUESTION_BANK_DATA_DIR=

# Absolute origin for metadata, robots.txt and the sitemap; Vercel supplies it in production.
# SITE_URL=https://onelystop.in

NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_ENABLED=false
SITE_CURRENCY=INR

NEWSDATA_API_KEY=
CRON_SECRET=
# GENERATION_MODEL=z-ai/glm-5.3
# GENERATION_RPM=12

# Powers Ask Onely (the study tutor), descriptive marking and the fallback.
# Key: https://openrouter.ai/keys — model slugs: https://openrouter.ai/models
OPENROUTER_API_KEY=
# Descriptive marking:
# AI_MODEL=meta/muse-spark-1.3
# Ask Onely runs on the cheap model:
# AI_CHEAP_MODEL=deepseek/deepseek-v4-flash-0731
# AI_MODEL_FALLBACK=openai/gpt-4o
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=2000
# AI_TIMEOUT_MS=60000
# AI_TOTAL_TIMEOUT_MS=120000
# AI_MAX_ATTEMPTS=3
