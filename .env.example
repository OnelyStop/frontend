# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# OpenRouter — one key for every AI feature. Server-only: never NEXT_PUBLIC_.
# Set a credit limit on the key in the OpenRouter dashboard as a backstop; the
# per-user cap in src/features/ai/models.ts is the actual control.
OPENROUTER_API_KEY=sk-or-v1-your-key
