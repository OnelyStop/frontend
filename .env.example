# Supabase — Project Settings > API. Authentication > URL Configuration must
# list <origin>/auth/callback and <origin>/reset-password, or the emails land
# on Site URL instead. Point the email templates (Confirm signup, Reset
# password, Magic link, Invite) at
# {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=signup|recovery|magiclink|invite
# so a link works on any device, not only the browser that asked for it;
# /auth/callback stays for OAuth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Absolute origin for metadata, robots.txt and the sitemap. Vercel supplies it
# in production; set it for any other host.
# SITE_URL=https://onelystop.in

# Payments (Razorpay). RAZORPAY_KEY_ID is public by design — the subscription
# route hands it to Checkout — and authorises nothing alone; the two secrets
# never leave the server. BILLING_ENABLED gates checkout so payments can be
# switched off without a deploy.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_ENABLED=false
# SITE_CURRENCY=INR   pins the currency for a single-domain deployment; otherwise the Host decides

# Current-affairs pipeline. All server-only. Vercel Cron sends CRON_SECRET as a
# Bearer token to /api/v1/internal/*; set the same value in the project env.
NEWSDATA_API_KEY=
GEMINI_API_KEY=
CRON_SECRET=
# GENERATION_MODEL=gemini-flash-lite-latest
# GENERATION_RPM=12   requests per minute; free-tier Gemini keys allow ~15

# ---------------------------------------------------------------------------
# AI. Only OPENROUTER_API_KEY is required; the rest override src/config/openrouter.ts.
# Server-only: never NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# The model used when a call does not name one.
# AI_MODEL=anthropic/claude-sonnet-4.5
# AI_MODEL_FALLBACK=openai/gpt-4o

# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Defaults for anything a call does not pass. Out-of-range values are ignored.
# AI_TEMPERATURE=0.7          0-2
# AI_MAX_TOKENS=2000          1-32000
# AI_TIMEOUT_MS=60000         per attempt
# AI_TOTAL_TIMEOUT_MS=120000  ceiling across all attempts and models
# AI_MAX_ATTEMPTS=3           1-5
