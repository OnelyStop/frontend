# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# ---------------------------------------------------------------------------
# AI. Only OPENROUTER_API_KEY is required; the rest override src/config/env.ts.
# All server-only: never NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# The default model, used when a call does not name one.
# AI_MODEL_DEFAULT=anthropic/claude-sonnet-4.5
# AI_MODEL_FAST=google/gemini-2.0-flash
# AI_MODEL_FALLBACK=openai/gpt-4o

# LLM_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Defaults for anything a call does not pass.
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=2000
# AI_TIMEOUT_MS=60000
# AI_MAX_ATTEMPTS=3
