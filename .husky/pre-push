#!/bin/bash
# Types and tests live here rather than in pre-commit because they take about
# fifteen seconds together: fine once per push, intolerable on every commit.
#
# The main refusal is a convenience — the protect-main ruleset is what actually
# stops it, and --no-verify skips this. It saves the round trip.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      current=$(git rev-parse --abbrev-ref HEAD)
      cat >&2 <<EOF

  Direct push to main is not allowed.

  You are on: $current

  Open a pull request instead:

      git switch -c <area>/<what-you-did>
      git push -u origin <branch>
      gh pr create

  The protect-main ruleset would reject this anyway; this just saves the wait.

EOF
      exit 1
      ;;
  esac
done

# Pushing a brand-new branch is the moment before `gh pr create`, and the only
# local point where the one-open-PR rule can still be cheap to obey. Once the
# second PR exists it costs a review cycle to undo.
if ! git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  open=$(gh pr list --state open --base main --json number,headRefName \
           --jq '.[] | "  #\(.number)  \(.headRefName)"' 2>/dev/null || true)

  if [ -n "$open" ] && [ "${SHIP_NEW_PR:-}" != "1" ]; then
    cat >&2 <<EOF

  A pull request is already open:

$open

  P3 and P4 work commits onto that branch, not a second one — a small fix
  opened separately costs a full review cycle on work that could have ridden
  along.

      git switch <that branch> && git cherry-pick $(git rev-parse --short HEAD)

  If this is genuinely P0, P1, or a P2 large enough to bury that review:

      SHIP_NEW_PR=1 git push -u origin $(git rev-parse --abbrev-ref HEAD)

EOF
    exit 1
  fi
fi

echo "  types…"
./node_modules/.bin/tsc --noEmit || exit 1

echo "  tests…"
./node_modules/.bin/vitest run --silent || exit 1

cat <<EOF
  ok

  Before opening the PR:
    - one of P0 P1 P2 P3 P4 as a label
    - Closes #N for P0-P2, or the no-issue label for P3-P4
EOF
